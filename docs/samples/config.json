    "alpine": {
      "basedOn": "default",
      "label": "Alpine Linux 3.24",
      "memory": 512,
      "image:qemu": "images/alpine.raw",
      "image:vbox": "images/alpine.vdi"
    },
    "debian13-cloud": {
      "basedOn": "default",
      "label": "Debian 13 Cloud",
      "memory": 1024,
      "image:qemu": "images/debian13-cloud.raw",
      "image:vbox": "images/debian13-cloud.vdi"
    },
    "openwrt": {
      "basedOn": "default",
      "label": "OpenWrt 25.12 x86-64",
