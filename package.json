{
  "name": "qemuweb",
  "version": "0.9.9",
  "private": true,
  "license": "MIT",
  "description": "Browser-based host and switch console for QEMU and VirtualBox",
  "scripts": {
    "start": "bash scripts/start.sh",
    "docs": "make docs",
    "test": "node --test test/unit/*.test.js",
    "test:two-hosts-stop-resume": "node test/integration/two-hosts-stop-resume.js",
    "test:four-hosts-startup": "node test/integration/four-hosts-startup.js",
    "test:check-host-debian13-legacy": "CHECK_HOST_PROFILE=debian13-legacy node test/integration/check-host.js",
    "test:check-host-debian13-cloud": "CHECK_HOST_PROFILE=debian13-cloud node test/integration/check-host.js",
    "test:check-host-alpine": "CHECK_HOST_PROFILE=alpine node test/integration/check-host.js",
    "test:check-host-openwrt": "CHECK_HOST_PROFILE=openwrt node test/integration/check-host.js",
    "test:check-network-debian13-legacy": "GUEST_NETWORK_PROFILES=debian13-legacy node test/integration/check-network.js",
    "test:check-network-debian13-cloud": "GUEST_NETWORK_PROFILES=debian13-cloud node test/integration/check-network.js",
    "test:check-network-alpine": "GUEST_NETWORK_PROFILES=alpine node test/integration/check-network.js",
    "test:check-network-openwrt": "GUEST_NETWORK_PROFILES=openwrt node test/integration/check-network.js",
    "test:two-users-isolation": "node test/integration/two-users-isolation.js",
    "test:session-reconnect": "node test/integration/session-reconnect.js",
    "test:admin": "node test/integration/admin.js",
    "test:check-runner": "node test/integration/check-runner.js",
    "test:check-runner-manual": "node test/integration/check-runner-manual.js",
    "test:check-runner-remote": "node test/integration/check-runner-remote.js",
    "test:check-load": "node test/integration/check-load.js",
    "test:check-load-start": "node test/integration/check-load-start.js",
    "test:check-console": "node test/integration/check-console.js"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "express": "4.22.3",
    "node-pty": "1.1.0",
    "socket.io": "4.8.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4"
  }
}
