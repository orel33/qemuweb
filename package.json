{
  "name": "qemuweb",
  "version": "0.7.0",
  "private": true,
  "description": "Browser-based host and switch console for QEMU and VirtualBox",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/unit/*.test.js",
    "test:lan2": "node test/integration/lan2-integration.js",
    "test:lan4-startup": "node test/integration/lan4-startup-templates.js",
    "test:gts16-lan2": "LAN2_GTS16=1 node test/integration/lan2-integration.js",
    "test:gts16-profiles": "node test/integration/gts16-profiles.js",
    "test:guest-network": "node test/integration/guest-network.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "4.18.1",
    "node-pty": "1.1.0",
    "socket.io": "2.3.0",
    "xterm": "4.6.0",
    "xterm-addon-fit": "0.5.0"
  },
  "devDependencies": {
    "socket.io-client": "2.3.0"
  }
}
