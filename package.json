{
  "name": "qemuweb",
  "version": "0.9.0-beta.2",
  "private": true,
  "description": "Browser-based host and switch console for QEMU and VirtualBox",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/unit/*.test.js",
    "test:two-hosts": "node test/integration/two-hosts-ping.js",
    "test:four-hosts-startup": "node test/integration/four-hosts-startup.js",
    "test:two-hosts-startup-media": "TWO_HOSTS_STARTUP_MEDIA=1 node test/integration/two-hosts-ping.js",
    "test:startup-media-profiles": "node test/integration/startup-media-profiles.js",
    "test:guest-network": "node test/integration/guest-network.js"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "express": "4.22.3",
    "node-pty": "1.1.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4"
  }
}
