{
  "schemaVersion": 1,
  "session": {"defaults": {"engine": "qemu"}},
  "settings": {
    "defaults": {
      "memory": 512,
      "cpus": 1,
      "clock": "utc"
    },
    "fields": {
      "memory": {"label": "Memory", "type": "number", "unit": "MB", "min": 64, "max": 32768, "step": 64},
      "cpus": {"label": "Processors", "type": "number", "min": 1, "max": 64, "step": 1},
      "clock": {"label": "Hardware clock", "type": "select", "options": ["utc", "localtime"]}
    }
  },
  "qemu": {
    "defaults": {
      "machine": "q35",
      "cpuKvm": "host",
      "cpuTcg": "qemu64",
      "display": "none",
      "diskInterface": "virtio",
      "networkModel": "virtio-net-pci",
      "bootDisk": "c",
      "nic": "none"
    }
  },
  "systems": {
    "alpine": {
      "type": "linux",
      "mode": "text",
      "label": "Alpine Linux 3.24",
      "images": {
        "raw": "images/alpine.raw",
        "vdi": "images/alpine.vdi"
      },
      "settings": {},
      "qemu": {},
      "virtualbox": {
        "nic": "none",
        "osType": "Linux_64"
      }
    },
    "debian13-cloud": {
      "type": "linux",
      "mode": "text",
      "label": "Debian 13 Cloud",
      "images": {
        "raw": "images/debian13-cloud.raw",
        "vdi": "images/debian13-cloud.vdi"
      },
      "settings": {"memory": 1024},
      "qemu": {
        "diskInterface": "virtio",
        "networkModel": "virtio-net-pci"
