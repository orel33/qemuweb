{
  "qemu": {
    "defaults": {
      "machine": "q35",
      "cpuKvm": "host",
      "cpuTcg": "qemu64",
      "memory": 512,
      "smp": 1,
      "display": "none",
      "rtcBase": "utc",
      "diskInterface": "virtio",
      "networkModel": "virtio-net-pci",
      "bootDisk": "c",
      "nic": "none"
    }
  },
  "systems": {
    "alpine": {
      "type": "linux",
      "mode": "text",
      "label": "Alpine Linux 3.24",
      "description": "Lightweight Alpine Linux, serial-ready.",
      "login": "root (no password); toto / toto",
      "images": {
        "raw": "images/alpine.raw",
        "vdi": "images/alpine.vdi"
      },
      "qemu": {},
      "virtualbox": {
        "memory": 512,
        "nic": "none",
        "osType": "Linux_64"
      }
    },
    "debian13-cloud": {
      "type": "linux",
      "mode": "text",
      "label": "Debian 13 Cloud",
      "description": "Debian 13 cloud image with VirtIO hardware.",
      "login": "root (no password); toto / toto",
      "images": {
        "raw": "images/debian13-cloud.raw",
        "vdi": "images/debian13-cloud.vdi"
      },
      "qemu": {
        "memory": 1024,
        "diskInterface": "virtio",
        "networkModel": "virtio-net-pci"
      },
      "virtualbox": {
        "memory": 1024,
        "nic": "none",
        "osType": "Linux_64"
      }
    },
    "debian13-legacy": {
      "type": "linux",
      "mode": "text",
      "label": "Debian 13 Legacy",
      "description": "Debian 13 networking labs (IDE, e1000, Scapy, Apache).",
      "login": "root (no password); toto / toto",
      "images": {
        "raw": "images/debian13-legacy.raw",
        "vdi": "images/debian13-legacy.vdi"
      },
      "qemu": {
        "memory": 1024,
        "diskInterface": "ide",
        "networkModel": "e1000"
      },
      "virtualbox": {
        "memory": 1024,
        "nic": "none",
        "osType": "Linux_64"
      }
    },
    "openwrt": {
      "type": "linux",
      "mode": "text",
      "label": "OpenWrt 25.12 x86-64",
      "description": "Lightweight OpenWrt network appliance.",
      "login": "Press Enter; root (no password); toto / toto",
      "images": {
        "raw": "images/openwrt.raw",
        "vdi": "images/openwrt.vdi"
      },
      "qemu": {
        "memory": 256,
        "nic": "none"
      },
      "virtualbox": {
        "memory": 256,
        "nic": "none",
        "osType": "Linux_64"
      }
    }
  }
}
